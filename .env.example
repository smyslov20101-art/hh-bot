# ─── Telegram бот ───────────────────────────────────────
# Токен от @BotFather (примерно так выглядит: 1234567890:AAEhBOweik...)
TELEGRAM_BOT_TOKEN=

# Твой Telegram user ID (узнать: написать @userinfobot)
# Бот будет работать только с тобой
TELEGRAM_USER_ID=

# ─── hh.ru OAuth (заполнятся автоматически через hh_auth.py) ──
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_RESUME_ID=

# ─── Поиск ──────────────────────────────────────────────
SEARCH_QUERIES=Claude Code,AI разработчик,Prompt инженер,вайб кодер,AI специалист
MIN_SALARY=60000
MAX_VACANCIES=40
